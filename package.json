{
  "name": "folio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @folio/web dev",
    "build": "pnpm --filter @folio/web build",
    "preview": "pnpm --filter @folio/web preview",
    "typecheck": "tsc -p .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @folio/web test:e2e",
    "tokens": "tsx packages/ui/scripts/build-tokens.ts",
    "budget": "node scripts/check-budget.mjs",
    "check": "pnpm tokens --check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "test:live": "pnpm --filter @folio/web exec playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "image-size": ">=2.0.3"
    }
  }
}
